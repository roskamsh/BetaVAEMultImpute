conda {
    enabled = true
    cacheDir = "${launchDir}/work/conda"
    channels = ["conda-forge","bioconda","defaults"]
}

process {
    conda = params.conda_cache ? "${params.conda_cache}/vae_imp_tf2" : "conda-forge::python=3.9 conda-forge::matplotlib=3.5 conda-forge::tensorflow-probability=0.15 conda-forge::scikit-learn=1.0 conda-forge::pandas=1.4 conda-forge::tensorflow=2.7 conda-forge::pandas=1.4 conda-forge::numpy=1.22"

    withLabel: lasso {
        conda = params.conda_cache ? "${params.conda_cache}/lasso" : "conda-forge::r-data.table=1.14 conda-forge::r-mass=7.3 conda-forge::r-pheatmap=1.0 conda-forge::r-penalized=0.9 conda-forge::r-caret=6.0 conda-forge::r-cowplot" 
    }
}