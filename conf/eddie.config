conda {
    enabled = true
    cacheDir = "${launchDir}/work/conda"
}

process {
    clusterOptions = {"-l h_vmem=${task.memory.bytes/task.cpus}"}
    executor = 'sge'
    penv = { task.cpus > 1 ? "sharedmem" : null }

    beforeScript = """
    . /etc/profile.d/modules.sh
    module load mamba/1.5.8
    module load igmm/apps/R/4.1.3
    """

    conda = "/exports/igmm/eddie/ponting-lab/breeshey/bin/conda_envs/vae_imp_tf2"

    withLabel: lasso {
        conda = "/exports/igmm/eddie/ponting-lab/breeshey/bin/conda_envs/lasso"
        //conda = "conda-forge::r-data.table=1.14 conda-forge::r-mass=7.3 conda-forge::r-pheatmap=1.0 conda-forge::r-penalized=0.9 conda-forge::r-caret=6.0"
    }

}

